[Unit]
Description=NOVA Security Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ nova_agent_install_root }}
ExecStart={{ nova_agent_install_root }}/.venv/bin/python {{ nova_agent_install_root }}/scripts/security_agent.py
Restart=always
RestartSec=5
User={{ nova_agent_user }}
Group={{ nova_agent_group }}
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_DAC_READ_SEARCH
ReadWritePaths=/var/lib/nova /var/log/nova
EnvironmentFile=-/etc/nova/security-agent.env

[Install]
WantedBy=multi-user.target
