APP_NAME=NOVA

VERSION=0.1.0

ENVIRONMENT=development

DEBUG=true

LOG_LEVEL=INFO

API_HOST=127.0.0.1

API_PORT=8000

DATABASE_URL=sqlite:///nova.db

LLM_PROVIDER=mlx

LLM_MODEL=qwen

WAKE_WORD=Nova
VOICE_NAME=Lekha
ENABLE_VOICE=true
TTS_NEURAL_ONLY=true

# Comma-separated list. Use * for local development.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*